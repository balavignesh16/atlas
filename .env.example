APP_ENV=development
LOG_LEVEL=INFO

# Application Ports
SPRING_PORT=8080
ATLAS_ENGINE_PORT=8081
ATLAS_AGENT_PORT=8082

# PostgreSQL (Future Dependency)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (Future Dependency)
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka (Future Dependency)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
